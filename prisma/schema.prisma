generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Auth (NextAuth) ─────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Email Triage ────────────────────────────────────────────────

model EmailItem {
  id          String    @id @default(cuid())
  subject     String
  senderName  String?
  senderEmail String?
  category    String    @default("general") // general | board | staff | funder | partner | resident | press | facilities | finance
  priority    String    @default("medium") // high | medium | low
  status      String    @default("triage") // triage | in_progress | waiting | done | archived
  summary     String?   @db.Text
  actionNote  String?   // what needs to happen next
  dueDate     DateTime?
  assignedTo  String?
  notes       String?   @db.Text
  receivedAt  DateTime  @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Gmail integration
  gmailId     String?   @unique // Gmail message id (dedupes synced mail)
  threadId    String?   // Gmail thread id (keeps replies in-thread)

  @@index([status])
  @@index([priority])
  @@index([receivedAt])
  @@index([category])
}

// ─── KPI Database ────────────────────────────────────────────────

model Kpi {
  id          String       @id @default(cuid())
  name        String
  description String?
  category    String       @default("operations") // programs | fundraising | operations | finance | impact | staff
  unit        String       @default("number") // number | percent | currency | hours
  target      Float?
  direction   String       @default("up") // "up" = higher is better, "down" = lower is better
  frequency   String       @default("monthly") // weekly | monthly | quarterly
  owner       String?      // staff member responsible
  archived    Boolean      @default(false)
  readings    KpiReading[]

  @@index([category])
  @@index([archived])
}

model KpiReading {
  id          String   @id @default(cuid())
  kpiId       String
  value       Float
  periodStart DateTime // start of the period this reading covers
  note        String?
  createdAt   DateTime @default(now())
  kpi         Kpi      @relation(fields: [kpiId], references: [id], onDelete: Cascade)

  @@unique([kpiId, periodStart])
  @@index([kpiId, periodStart])
}

// ─── Stakeholder & Staff Communication Tracking ──────────────────

model Stakeholder {
  id               String                 @id @default(cuid())
  name             String
  organization     String?
  title            String?
  type             String                 @default("partner") // staff | board | funder | partner | resident | government | vendor | other
  email            String?
  phone            String?
  importance       String                 @default("normal") // high | normal | low
  cadenceDays      Int?                   // target days between touches (e.g. 30)
  notes            String?                @db.Text
  lastContactAt    DateTime?
  archived         Boolean                @default(false)
  interactions     StakeholderInteraction[]

  @@index([type])
  @@index([archived])
  @@index([lastContactAt])
}

model StakeholderInteraction {
  id             String      @id @default(cuid())
  stakeholderId  String
  channel        String      @default("email") // email | call | meeting | text | event | other
  direction      String      @default("outbound") // inbound | outbound
  summary        String
  date           DateTime    @default(now())
  followUpNeeded Boolean     @default(false)
  followUpDate   DateTime?
  followUpDone   Boolean     @default(false)
  sentiment      String?     // positive | neutral | negative
  createdAt      DateTime    @default(now())
  stakeholder    Stakeholder @relation(fields: [stakeholderId], references: [id], onDelete: Cascade)

  @@index([stakeholderId, date])
  @@index([followUpNeeded, followUpDate])
}

// ─── Ideas ───────────────────────────────────────────────────────

model Idea {
  id          String   @id @default(uuid())
  title       String
  description String?
  category    String?
  type        String?
  model       String?
  status      String?
  timestamp   DateTime @default(now())

  @@index([category])
  @@index([type])
}

// ─── Tasks ───────────────────────────────────────────────────────

model Task {
  id        String    @id @default(cuid())
  name      String
  status    String    @default("Not started") // Not started | Approved | In progress | Done
  priority  String    @default("Medium") // High | Medium | Low
  category  String?
  dueDate   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([status])
}

// ─── Generic Key-Value Store ────────────────────────────────────

model DataStore {
  key       String   @id
  data      Json
  updatedAt DateTime @updatedAt
}

// ─── Hermes bus (website ↔ bridge on your machine) ──────────────
// Shared Postgres is the message bus. The bridge polls AgentRequest,
// runs approved/safe ones via the `hermes` CLI, and mirrors kanban
// tasks + activity back into HermesTask / AgentEvent.

model AgentRequest {
  id            String    @id @default(cuid())
  origin        String    @default("web")     // "web" | "hermes"
  kind          String    @default("oneshot") // "oneshot" | "kanban" | "chat"
  title         String
  prompt        String?
  sideEffecting Boolean   @default(false)
  status        String    @default("queued")  // queued | awaiting_approval | approved | running | done | failed | rejected
  result        String?
  error         String?
  hermesTaskId  String?
  decidedAt     DateTime?
  startedAt     DateTime?
  finishedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status])
  @@index([createdAt])
}

model AgentEvent {
  id        String   @id @default(cuid())
  kind      String   @default("activity") // activity | run | status | memory
  title     String
  detail    String?
  agent     String?
  level     String   @default("info")     // info | up | warn | down
  meta      Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model HermesTask {
  id        String   @id                   // Hermes task id
  board     String   @default("default")
  title     String
  assignee  String?
  status    String   @default("todo")
  priority  Int?
  result    String?
  updatedAt DateTime @default(now())
  syncedAt  DateTime @updatedAt

  @@index([board])
  @@index([status])
}

// ─── Hermes Memory Wiki (warm tier — git-tracked markdown, mirrored) ─────
model HermesMemory {
  id         String    @id            // wiki entry slug (relative path w/o .md)
  path       String                   // file path relative to wiki root
  type       String    @default("fact")
  title      String
  status     String    @default("active")
  confidence String?
  provenance String?
  tags       String[]
  links      String[]
  body       String    @default("")
  validFrom  DateTime?
  validTo    DateTime?
  updatedAt  DateTime  @default(now())
  syncedAt   DateTime  @updatedAt

  @@index([type])
  @@index([status])
}
